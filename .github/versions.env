# Single source of truth for the toolchain versions used by CI.
#
# Read by:
#   - .github/docker/ci.Dockerfile and e2e.Dockerfile (passed as --build-arg)
#   - .github/actions/setup-environment (the non-container fallback path)
#   - .github/scripts/image-tag.sh (changing a value changes the image tag)
#
# Format: KEY=value, one per line, no quotes, no spaces around '='.
# Lines starting with '#' and blank lines are ignored.

GO_VERSION=1.27.3
NODE_VERSION=24.22.3
TASK_VERSION=3.54.0
WAILS_VERSION=v3.1.0
GOLANGCI_LINT_VERSION=v2.15.0

# Keep these two in step with google.golang.org/protobuf and connectrpc.com/connect
# in src/cli/go.mod, so the generated code matches the runtime libraries.
PROTOC_GEN_GO_VERSION=v1.36.12
PROTOC_GEN_CONNECT_GO_VERSION=v1.21.1

# End-to-end image only (e2e.Dockerfile).
# AWS Emulator: versions.json at https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/
# lists releases as MAJOR.MINOR.PATCH.1 (for example 1.0.533.1), but the package file name
# uses MAJOR.MINOR.PATCH only: aws-emulator_1.0.533-1_amd64.deb. Put the three-part version here.
# Playwright must match the @playwright/test version the GUI e2e suite depends on.
AWS_EMULATOR_VERSION=1.0.533
PLAYWRIGHT_VERSION=1.65.1
