{
    "name": "@filemoverexpress/cli",
    "version": "1.0.0",
    "description": "FileMoverExpress CLI - Go-based command-line daemon for high-performance file transfers to/from Amazon S3",
    "private": true,
    "scripts": {
        "build": "ts-node ../build-scripts/build.ts cli build",
        "build:mac": "ts-node ../build-scripts/build.ts cli build --platforms darwin",
        "build:linux": "ts-node ../build-scripts/build.ts cli build --platforms linux",
        "build:windows": "ts-node ../build-scripts/build.ts cli build --platforms windows",
        "build:all": "ts-node ../build-scripts/build.ts cli build",
        "test": "go test -gcflags=\"all=-N -l\" -short -v -cover -coverprofile coverage.out ./... && go tool cover -html coverage.out -o coverage.html",
        "test:e2e": "cross-env E2E_TEST=true go test ./e2e-tests/... -v",
        "lint": "golangci-lint run",
        "lint:fix": "golangci-lint run --fix",
        "clean": "node ../build-scripts/cli/clean.js dist"
    },
    "keywords": [
        "aws",
        "s3",
        "file-transfer",
        "cli",
        "daemon"
    ],
    "author": "Amazon Web Services",
    "license": "Apache-2.0",
    "devDependencies": {
        "npm-run-all": "4.1.5",
        "cross-env": "10.1.0",
        "fast-check": "4.6.0"
    }
}
