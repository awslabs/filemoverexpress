{
    "name": "@filemoverexpress/ui",
    "productName": "File Mover Express",
    "license": "MIT",
    "version": "1.0.0",
    "main": "../electron/out/electron-main.js",
    "private": true,
    "scripts": {
        "ng": "ng",
        "prebuild": "",
        "start": "ng serve",
        "build": "ts-node ../build-scripts/build.ts gui build",
        "build:production": "ts-node ../build-scripts/build.ts gui build --production",
        "watch": "ng build --watch --configuration development",
        "electron:dev": "npm run build && cd ../electron && npm install && tsc && cd dist && electron .",
        "package:mac": "ts-node ../build-scripts/build.ts gui package --platforms darwin",
        "package:windows": "ts-node ../build-scripts/build.ts gui package --platforms windows",
        "package:all": "ts-node ../build-scripts/build.ts gui package",
        "test": "ng test --watch=false --code-coverage",
        "test:watch": "ng test",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "clean": "node ../build-scripts/gui/clean.js dist release-builds src/connect/gen"
    },
    "dependencies": {
        "@angular/animations": "21.2.7",
        "@angular/cdk": "21.2.5",
        "@angular/common": "21.2.7",
        "@angular/compiler": "21.2.7",
        "@angular/core": "21.2.7",
        "@angular/forms": "21.2.7",
        "@angular/material": "21.2.5",
        "@angular/platform-browser": "21.2.7",
        "@angular/platform-browser-dynamic": "21.2.7",
        "@angular/router": "21.2.7",
        "@bufbuild/protobuf": "2.11.0",
        "@connectrpc/connect": "2.1.1",
        "@connectrpc/connect-web": "2.1.1",
        "@ngrx/effects": "21.1.0",
        "@ngrx/entity": "21.1.0",
        "@ngrx/operators": "21.1.0",
        "@ngrx/store": "21.1.0",
        "@ngrx/store-devtools": "21.1.0",
        "csv-parse": "6.2.1",
        "date-fns": "4.1.0",
        "exceljs": "4.4.0",
        "google-protobuf": "3.21.4",
        "rxjs": "7.8.2",
        "semver-ts": "1.0.3",
        "tslib": "2.8.1",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/core": "21.2.6",
        "@angular-eslint/builder": "21.3.1",
        "@angular-eslint/eslint-plugin": "21.3.1",
        "@angular-eslint/eslint-plugin-template": "21.3.1",
        "@angular-eslint/schematics": "21.3.1",
        "@angular-eslint/template-parser": "21.3.1",
        "@angular/build": "21.2.6",
        "@angular/cli": "21.2.6",
        "@angular/compiler-cli": "21.2.7",
        "@eslint/js": "10.0.1",
        "@ngrx/schematics": "21.1.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/jasmine": "6.0.0",
        "@types/jasminewd2": "2.0.13",
        "@types/node": "25.5.2",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "@typescript-eslint/types": "8.58.0",
        "@typescript-eslint/utils": "8.58.0",
        "cross-env": "10.1.0",
        "electron": "41.1.1",
        "eslint": "10.2.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "62.9.0",
        "eslint-plugin-prefer-arrow": "1.2.3",
        "jasmine-core": "6.1.0",
        "jasmine-spec-reporter": "7.0.0",
        "karma": "6.4.4",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "2.2.1",
        "karma-jasmine": "5.1.0",
        "karma-jasmine-html-reporter": "2.2.0",
        "karma-mocha-reporter": "2.2.5",
        "npm-run-all": "4.1.5",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    }
}
